<!DOCTYPE html>
<html>
<head>
   <title><%= title %></title>
   <link rel='stylesheet' href='/stylesheets/style.css' />
</head>
<body style="padding: 30px;">
  <div style="max-width: 600px; margin: 0 auto; background: #0c1220; padding: 25px; border-radius: 14px; border: 1px solid rgba(0, 210, 255, 0.25);">
    <h1 style="color: #00d2ff; margin-top: 0;"><%= title %></h1>
    <img src="<%= picture %>" alt="<%= title %>" style="max-width: 100%; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1);"/>
    <h4 style="color: #94a3b8; font-weight: normal; margin-top: 15px;">Несколько слов о нашем плагине: <span style="color: #f8fafc;"><%= desc %></span></h4>
  </div>
</body>
</html>
