<% layout('./layout/page.ejs') %>

<div class="auth-card">
   <div class="text-center mb-4">
     <span style="font-size: 2.5rem;">🔐</span>
     <h2 style="color: #00d2ff; font-weight: 800; margin-top: 10px;">Вход в FL Studio</h2>
     <p class="text-secondary small">Введите логин и пароль. Если учетной записи ещё нет, она будет создана автоматически.</p>
   </div>
   <form class="form-horizontal">
       <div class="mb-3">
           <label class="form-label text-secondary small">Имя пользователя</label>
           <input class="form-control form-control-custom" type="text" placeholder="Например, producer" />
       </div>
       <div class="mb-4">
           <label class="form-label text-secondary small">Пароль</label>
           <input class="form-control form-control-custom" type="password" placeholder="Введите пароль" />
       </div>
       <button class="btn btn-cyan w-100" type="submit">Войти в систему</button>
   </form>
</div>
