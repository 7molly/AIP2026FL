<% layout('./layout/page.ejs') %>

<div class="auth-card">
   <div class="text-center mb-4">
     <span style="font-size: 2.5rem;">🔐</span>
     <h2 style="color: #00d2ff; font-weight: 800; margin-top: 10px;">Вход в FL Studio</h2>
     <p class="text-secondary small">Введите логин и пароль. Если учетной записи ещё нет, она будет создана автоматически.</p>
   </div>
   <form class="form-horizontal" action="/logreg" method="post">
       <div class="mb-3">
           <label class="form-label text-secondary small">Имя пользователя</label>
           <input class="form-control form-control-custom" type="text" placeholder="Например, producer" name="username" required />
       </div>
       <div class="mb-4">
           <label class="form-label text-secondary small">Пароль</label>
           <input class="form-control form-control-custom" type="password" placeholder="Введите пароль" name="password" required />
       </div>
       <button class="btn btn-cyan w-100 mb-3" type="submit">Войти в систему</button>
       
       <% if(typeof error !== 'undefined' && error) { %>
           <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5; border-radius: 10px;">
             <%= error %>
           </div>
       <% } %>
   </form>
</div>
